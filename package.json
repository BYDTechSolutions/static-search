{
  "name": "@bydtech/static-search",
  "version": "0.1.0",
  "description": "Full-text search for static sites: one build command over your HTML, a tiny browser runtime, and an optional drop-in <static-search> element.",
  "keywords": [
    "search",
    "static-site",
    "full-text-search",
    "bm25",
    "web-component",
    "nextjs",
    "astro",
    "hugo",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/static-search#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/static-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/static-search.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./static-search.js": "./dist/static-search.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "static-search": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./dist/static-search.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
